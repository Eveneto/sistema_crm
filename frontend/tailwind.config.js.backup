          },
        },
        '@screen crm-desktop': {
          '.crm-padding-responsive': {
            'padding': 'var(--crm-space-8)',
          },
        },
        '.crm-margin-responsive': {
          'margin': 'var(--crm-space-4)',
        },
        '@screen crm-tablet': {
          '.crm-margin-responsive': {
            'margin': 'var(--crm-space-6)',
          },
        },
        '@screen crm-desktop': {
          '.crm-margin-responsive': {
            'margin': 'var(--crm-space-8)',
          },
        },
        '.crm-gap-responsive': {
          'gap': 'var(--crm-space-3)',
        },
        '@screen crm-tablet': {
          '.crm-gap-responsive': {
            'gap': 'var(--crm-space-4)',
          },
        },
        '@screen crm-desktop': {
          '.crm-gap-responsive': {
            'gap': 'var(--crm-space-6)',
          },
        },

        // ===== BOTÕES E INTERAÇÕES =====
        '.crm-btn-primary': {
          'background-color': 'var(--crm-primary)',
          'color': 'var(--crm-text-primary)',
          'font-weight': 'var(--crm-font-weight-medium)',
          'padding': 'var(--crm-space-3) var(--crm-space-4)',
          'border-radius': 'var(--crm-radius-lg)',
          'border': '1px solid var(--crm-primary)',
          'transition': 'var(--crm-transition-base)',
        },
        '@screen crm-tablet': {
          '.crm-btn-primary': {
            'padding': 'var(--crm-space-4) var(--crm-space-6)',
          },
        },
        '.crm-btn-primary:hover': {
          'background-color': 'var(--crm-primary-light)',
          'border-color': 'var(--crm-primary-light)',
        },
        '.crm-btn-primary:focus': {
          'outline': 'none',
          'box-shadow': '0 0 0 2px var(--crm-accent), 0 0 0 4px rgba(59, 130, 246, 0.1)',
        },

        // ===== FORMULÁRIOS =====
        '.crm-input': {
          'width': '100%',
          'padding': 'var(--crm-space-3) var(--crm-space-4)',
          'background-color': 'var(--crm-bg-primary)',
          'border': '1px solid var(--crm-border)',
          'border-radius': 'var(--crm-radius-lg)',
          'color': 'var(--crm-text-primary)',
          'transition': 'var(--crm-transition-base)',
        },
        '.crm-input::placeholder': {
          'color': 'var(--crm-text-tertiary)',
        },
        '.crm-input:focus': {
          'outline': 'none',
          'border-color': 'var(--crm-accent)',
          'box-shadow': '0 0 0 2px var(--crm-accent), 0 0 0 4px rgba(59, 130, 246, 0.1)',
        },

        // ===== DASHBOARD ESPECÍFICO =====
        '.crm-dashboard-stats': {
          'display': 'grid',
          'gap': 'var(--crm-space-4)',
          'grid-template-columns': 'repeat(1, minmax(0, 1fr))',
          'margin-bottom': 'var(--crm-space-8)',
        },
        '@screen crm-tablet': {
          '.crm-dashboard-stats': {
            'grid-template-columns': 'repeat(2, minmax(0, 1fr))',
          },
        },
        '@screen crm-desktop': {
          '.crm-dashboard-stats': {
            'grid-template-columns': 'repeat(4, minmax(0, 1fr))',
          },
        },
        '.crm-chart-container': {
          'background-color': 'var(--crm-bg-elevated)',
          'border': '1px solid var(--crm-border)',
          'border-radius': 'var(--crm-radius-xl)',
          'box-shadow': 'var(--crm-shadow-sm)',
          'padding': 'var(--crm-space-6)',
          'transition': 'var(--crm-transition-base)',
          'height': '20rem',
        },
        '@screen crm-tablet': {
          '.crm-chart-container': {
            'height': '24rem',
          },
        },
        '.crm-chart-container:hover': {
          'box-shadow': 'var(--crm-shadow-md)',
          'transform': 'translateY(-2px)',
        },
        '.crm-dashboard-chart-height': {
          'height': '16rem',
        },
        '@screen crm-tablet': {
          '.crm-dashboard-chart-height': {
            'height': '20rem',
          },
        },
        '.crm-dashboard-chart-small': {
          'height': '12rem',
        },
        '@screen crm-tablet': {
          '.crm-dashboard-chart-small': {
            'height': '16rem',
          },
        },

        // ===== GRADIENTES E EFEITOS VISUAIS =====
        '.crm-gradient-primary': {
          'background': 'linear-gradient(135deg, var(--crm-primary) 0%, var(--crm-primary-light) 100%)',
        },
        '.crm-gradient-accent': {
          'background': 'linear-gradient(135deg, var(--crm-accent) 0%, #3b82f6 100%)',
        },
        '.crm-gradient-success': {
          'background': 'linear-gradient(135deg, var(--crm-success) 0%, #10b981 100%)',
        },
        '.crm-glass-effect': {
          'background': 'rgba(255, 255, 255, 0.1)',
          'backdrop-filter': 'blur(10px)',
          'border': '1px solid rgba(255, 255, 255, 0.2)',
        },
        '.crm-glow-primary': {
          'box-shadow': '0 0 20px rgba(59, 130, 246, 0.3)',
        },
        '.crm-glow-success': {
          'box-shadow': '0 0 20px rgba(16, 185, 129, 0.3)',
        },

        // ===== ANIMAÇÕES E TRANSIÇÕES =====
        '.crm-fade-in': {
          'animation': 'crm-fade-in 0.5s ease-out',
        },
        '.crm-slide-up': {
          'animation': 'crm-slide-up 0.6s ease-out',
        },
        '.crm-bounce-in': {
          'animation': 'crm-bounce-in 0.8s ease-out',
        },
        '.crm-pulse-gentle': {
          'animation': 'crm-pulse-gentle 2s infinite',
        },
        '.crm-hover-lift': {
          'transition': 'all var(--crm-transition-base)',
        },
        '.crm-hover-lift:hover': {
          'transform': 'translateY(-4px) scale(1.02)',
          'box-shadow': 'var(--crm-shadow-lg)',
        },

        // ===== UTILITÁRIOS AVANÇADOS =====
        '.crm-text-gradient': {
          'background': 'linear-gradient(135deg, var(--crm-primary), var(--crm-accent))',
          '-webkit-background-clip': 'text',
          '-webkit-text-fill-color': 'transparent',
          'background-clip': 'text',
        },
        '.crm-border-gradient': {
          'background': 'linear-gradient(135deg, var(--crm-primary), var(--crm-accent))',
          'padding': '2px',
          'border-radius': 'var(--crm-radius-lg)',
        },
        '.crm-border-gradient > *': {
          'background': 'var(--crm-bg-primary)',
          'border-radius': 'calc(var(--crm-radius-lg) - 2px)',
        },
        '.crm-avatar': {
          'width': '2.5rem',
          'height': '2.5rem',
          'border-radius': '50%',
          'display': 'flex',
          'align-items': 'center',
          'justify-content': 'center',
          'font-weight': 'var(--crm-font-weight-medium)',
          'color': 'var(--crm-text-primary)',
        },
        '.crm-avatar-primary': {
          'background-color': 'var(--crm-primary)',
          'color': 'white',
        },
        '.crm-avatar-success': {
          'background-color': 'var(--crm-success)',
          'color': 'white',
        },
        '.crm-avatar-warning': {
          'background-color': 'var(--crm-warning)',
          'color': 'white',
        },
        '.crm-avatar-info': {
          'background-color': 'var(--crm-info)',
          'color': 'white',
        },

        // ===== COMPONENTES ESPECIAIS =====
        '.crm-metric-card': {
          'background': 'linear-gradient(135deg, var(--crm-bg-elevated) 0%, rgba(255,255,255,0.05) 100%)',
          'border': '1px solid var(--crm-border)',
          'border-radius': 'var(--crm-radius-xl)',
          'padding': 'var(--crm-space-6)',
          'position': 'relative',
          'overflow': 'hidden',
          'transition': 'all var(--crm-transition-base)',
        },
        '.crm-metric-card::before': {
          'content': "''",
          'position': 'absolute',
          'top': '0',
          'left': '0',
          'right': '0',
          'height': '3px',
          'background': 'linear-gradient(90deg, var(--crm-primary), var(--crm-accent))',
        },
        '.crm-metric-card:hover': {
          'transform': 'translateY(-2px)',
          'box-shadow': 'var(--crm-shadow-lg)',
          'border-color': 'var(--crm-primary)',
        },
        '.crm-status-indicator': {
          'width': '0.75rem',
          'height': '0.75rem',
          'border-radius': '50%',
          'display': 'inline-block',
          'margin-right': 'var(--crm-space-2)',
        },
        '.crm-status-online': {
          'background-color': 'var(--crm-success)',
          'box-shadow': '0 0 6px var(--crm-success)',
        },
        '.crm-status-offline': {
          'background-color': 'var(--crm-text-tertiary)',
        },
        '.crm-status-away': {
          'background-color': 'var(--crm-warning)',
        },
      });
    },
  ],
  // Keyframes para animações customizadas
  keyframes: {
    'crm-fade-in': {
      '0%': { opacity: '0' },
      '100%': { opacity: '1' },
    },
    'crm-slide-up': {
      '0%': { transform: 'translateY(20px)', opacity: '0' },
      '100%': { transform: 'translateY(0)', opacity: '1' },
    },
    'crm-bounce-in': {
      '0%': { transform: 'scale(0.3)', opacity: '0' },
      '50%': { transform: 'scale(1.05)' },
      '70%': { transform: 'scale(0.9)' },
      '100%': { transform: 'scale(1)', opacity: '1' },
    },
    'crm-pulse-gentle': {
      '0%, 100%': { opacity: '1' },
      '50%': { opacity: '0.7' },
    },
  },
}
